library(svars)

v_2 <- na.omit(cbind(mortgage = mortgage_ld, fed = fedfunds_diff, housing = houses_ld))
var_4b <- VAR(v_2, p = 4, type = "const")

Sigma_u <- crossprod(resid(var_4b)) / nrow(resid(var_4b))

A0_restr <- matrix(NA, 3, 3)
colnames(A0_restr) <- rownames(A0_restr) <- c("mortgage", "fed", "housing")

A0_restr[1, ] <- c(1, 0, 0)
A0_restr[2, ] <- c(NA, 1, 0)
A0_restr[3, ] <- c(NA, NA, 1)

B_restr <- diag(NA, 3)

svar_model2 <- SVAR(var_4b,
                    estmethod = "direct",
                    Amat = A0_restr,
                    Bmat = B_restr,
                    max.iter = 1000)

summary(svar_model2)

